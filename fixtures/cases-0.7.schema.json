{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emindeniz99/apple-purchase-receipt-verifier/fixtures/cases-0.7.schema.json",
  "title": "Apple purchase receipt verifier: cross-language conformance vectors for the 0.7 API",
  "description": "Schema for fixtures/cases-0.7.json (schema version 2). Every port runs the same cases against the same fixture bytes through the three 0.7 methods of docs/design/0.7-api.md and must produce the same answer. The file's comment defines how runners hand inputs over and evaluate expectations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "comment", "fixtures", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "comment": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/fixtureId" },
      "additionalProperties": { "$ref": "#/$defs/fixture" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "codec", "contentSha256"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path relative to fixtures/. generated-0.7/ holds the receipts re-minted for 0.7 and the inputs new in 0.7.",
          "pattern": "^(generated|generated-0\\.7|public-receipts|apple-official|limits)/[A-Za-z0-9._/-]+$"
        },
        "role": {
          "description": "input = bytes handed to an operation; trust-anchor = a certificate the verifier is configured with; support = neither, kept registered so the tier stays accounted for.",
          "enum": ["input", "trust-anchor", "support"]
        },
        "codec": {
          "description": "How the file encodes its logical bytes. raw = the file bytes; base64 = base64 text (whitespace stripped) decoding to the bytes; utf8 = text whose trimmed UTF-8 encoding is the bytes; text = the file bytes verbatim, untrimmed, handed to a string-taking method as the exact string a client sent.",
          "enum": ["raw", "base64", "utf8", "text"]
        },
        "contentSha256": {
          "type": "string",
          "description": "SHA-256, lowercase hex, of the decoded logical bytes, not of the file as stored.",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reason": {
      "description": "The 0.7 Reason set (docs/design/0.7-api.md, Result).",
      "enum": [
        "MALFORMED",
        "TOO_LARGE",
        "INVALID_SIGNATURE",
        "UNTRUSTED_CHAIN",
        "INVALID_CERTIFICATE",
        "INVALID_CERTIFICATE_PURPOSE",
        "UNREADABLE_PAYLOAD",
        "INTERNAL_ERROR"
      ]
    },
    "trustedRoots": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "description": "The roots of Config.defaults(): the three bundled, pinned Apple roots.",
          "properties": { "source": { "const": "defaults" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "fixtures"],
          "description": "Roots read from registered trust-anchor fixtures.",
          "properties": {
            "source": { "const": "fixtures" },
            "fixtures": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/fixtureId" }
            }
          }
        }
      ]
    },
    "verifyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustedRoots"],
      "properties": { "trustedRoots": { "$ref": "#/$defs/trustedRoots" } }
    },
    "endpointConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustedRoots", "environment"],
      "properties": {
        "trustedRoots": { "$ref": "#/$defs/trustedRoots" },
        "environment": {
          "description": "The Environment passed to verifyReceiptEndpoint: which of Apple's two URLs the call imitates.",
          "enum": ["PRODUCTION", "SANDBOX"]
        }
      }
    },
    "fixtureInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture"],
      "properties": { "fixture": { "$ref": "#/$defs/fixtureId" } },
      "description": "One registered fixture. For verifyReceipt and the endpoint's receipt-data a text fixture is the string verbatim and a raw or base64 fixture is DER the runner encodes as canonical base64."
    },
    "endpointInput": {
      "oneOf": [
        { "$ref": "#/$defs/fixtureInput" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestBody"],
          "properties": { "requestBody": { "$ref": "#/$defs/fixtureId" } },
          "description": "A text fixture that is the whole request body, handed to verifyReceiptEndpoint verbatim."
        }
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["now"],
      "properties": {
        "now": {
          "type": "string",
          "description": "The instant the Config clock answers, ISO-8601 UTC. Required whenever the verdict or an asserted field moves with the clock.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "caseId": {
      "type": "string",
      "description": "Stable, unique, kebab-case, \"<area>/<what>\".",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "legacyId": {
      "$ref": "#/$defs/caseId",
      "description": "The id of the fixtures/cases.json case this one replaces. Absent on a case new in 0.7."
    },
    "description": { "type": "string", "minLength": 1 },
    "maxMillis": {
      "type": "integer",
      "minimum": 1,
      "description": "A wall-clock budget in milliseconds for the verify call. The runner measures the call after one warm-up call of the same case and fails if it exceeds this. Set only on DoS cases; the file comment gives the shared figure."
    },
    "fault": {
      "type": "string",
      "description": "The one intentional defect of a negative case. Documentation, never asserted.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "pointer": {
      "type": "string",
      "description": "A JSON Pointer (RFC 6901), with one extension: a reference token [key=value] selects the single element of an array whose member key is the JSON string value.",
      "pattern": "^(/([^/~]|~[01])*)+$"
    },
    "fieldValue": { "type": ["string", "number", "boolean", "null"] },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "description": "Pointer to pinned value. null means absent or JSON null; numbers compare by value.",
      "propertyNames": { "$ref": "#/$defs/pointer" },
      "additionalProperties": { "$ref": "#/$defs/fieldValue" }
    },
    "lengths": {
      "type": "object",
      "minProperties": 1,
      "description": "Pointer to the length of the array there.",
      "propertyNames": { "$ref": "#/$defs/pointer" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "expectedError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "error" },
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "expectedReceiptOk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "Evaluated on JSON.parse(ReceiptPayload.toJson()).",
      "properties": {
        "status": { "const": "ok" },
        "fields": { "$ref": "#/$defs/fields" },
        "lengths": { "$ref": "#/$defs/lengths" },
        "toJson": {
          "type": "string",
          "minLength": 2,
          "description": "The exact string toJson() returns; the runner compares the UTF-8 bytes."
        }
      }
    },
    "expectedSignedDataOk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "Evaluated on JSON.parse(JsonPayload.json()).",
      "properties": {
        "status": { "const": "ok" },
        "fields": { "$ref": "#/$defs/fields" },
        "lengths": { "$ref": "#/$defs/lengths" }
      }
    },
    "expectedEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "description": "verifyReceiptEndpoint never fails: it returns Apple's response body, evaluated as JSON. /status is always pinned.",
      "properties": {
        "fields": {
          "allOf": [
            { "$ref": "#/$defs/fields" },
            {
              "type": "object",
              "required": ["/status"],
              "properties": {
                "/status": { "enum": [0, 21002, 21003, 21007, 21008, 21009] }
              }
            }
          ]
        },
        "lengths": { "$ref": "#/$defs/lengths" }
      }
    },
    "faultRequiredOnError": {
      "if": {
        "type": "object",
        "required": ["expected"],
        "properties": {
          "expected": {
            "type": "object",
            "required": ["status"],
            "properties": { "status": { "const": "error" } }
          }
        }
      },
      "then": { "required": ["fault"] }
    },
    "case": {
      "type": "object",
      "oneOf": [
        {
          "title": "verifyReceipt(base64): legacy PKCS#7 receipt",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description", "operation", "input", "config", "expected", "tags"],
          "allOf": [{ "$ref": "#/$defs/faultRequiredOnError" }],
          "properties": {
            "id": { "$ref": "#/$defs/caseId" },
            "legacyId": { "$ref": "#/$defs/legacyId" },
            "description": { "$ref": "#/$defs/description" },
            "operation": { "const": "verifyReceipt" },
            "input": { "$ref": "#/$defs/fixtureInput" },
            "config": { "$ref": "#/$defs/verifyConfig" },
            "maxMillis": { "$ref": "#/$defs/maxMillis" },
            "clock": { "$ref": "#/$defs/clock" },
            "expected": {
              "oneOf": [
                { "$ref": "#/$defs/expectedReceiptOk" },
                { "$ref": "#/$defs/expectedError" }
              ]
            },
            "fault": { "$ref": "#/$defs/fault" },
            "tags": { "$ref": "#/$defs/tags" }
          }
        },
        {
          "title": "verifySignedData(jws): any Apple JWS",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description", "operation", "input", "config", "expected", "tags"],
          "allOf": [{ "$ref": "#/$defs/faultRequiredOnError" }],
          "properties": {
            "id": { "$ref": "#/$defs/caseId" },
            "legacyId": { "$ref": "#/$defs/legacyId" },
            "description": { "$ref": "#/$defs/description" },
            "operation": { "const": "verifySignedData" },
            "input": { "$ref": "#/$defs/fixtureInput" },
            "config": { "$ref": "#/$defs/verifyConfig" },
            "maxMillis": { "$ref": "#/$defs/maxMillis" },
            "clock": { "$ref": "#/$defs/clock" },
            "expected": {
              "oneOf": [
                { "$ref": "#/$defs/expectedSignedDataOk" },
                { "$ref": "#/$defs/expectedError" }
              ]
            },
            "fault": { "$ref": "#/$defs/fault" },
            "tags": { "$ref": "#/$defs/tags" }
          }
        },
        {
          "title": "verifyReceiptEndpoint(environment, requestJson): Apple's verifyReceipt response",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description", "operation", "input", "config", "expected", "tags"],
          "properties": {
            "id": { "$ref": "#/$defs/caseId" },
            "legacyId": { "$ref": "#/$defs/legacyId" },
            "description": { "$ref": "#/$defs/description" },
            "operation": { "const": "verifyReceiptEndpoint" },
            "input": { "$ref": "#/$defs/endpointInput" },
            "config": { "$ref": "#/$defs/endpointConfig" },
            "clock": { "$ref": "#/$defs/clock" },
            "expected": { "$ref": "#/$defs/expectedEndpoint" },
            "fault": { "$ref": "#/$defs/fault" },
            "tags": { "$ref": "#/$defs/tags" }
          }
        },
        {
          "title": "decodeBase64: internal hook, one group of base64 spellings through the named decoders",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description", "operation", "decoders", "input", "expected", "tags"],
          "properties": {
            "id": { "$ref": "#/$defs/caseId" },
            "legacyId": { "$ref": "#/$defs/legacyId" },
            "description": { "$ref": "#/$defs/description" },
            "operation": { "const": "decodeBase64" },
            "decoders": {
              "description": "Each decoder called directly from the port's test code, not through a public method. \"receipt-data\" refuses with MALFORMED; \"x5c\" refuses with INVALID_CERTIFICATE. An error group states MALFORMED and the runner maps it for x5c. No decoder may be listed twice.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["receipt-data", "x5c"] }
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["texts"],
              "properties": {
                "texts": {
                  "description": "The spellings, as the exact strings a client or a JWS header carries. Every one must get the group's answer.",
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              }
            },
            "expected": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "bytesHex"],
                  "properties": {
                    "status": { "const": "ok" },
                    "bytesHex": {
                      "description": "The bytes every text decodes to, as lowercase hex.",
                      "type": "string",
                      "pattern": "^([0-9a-f]{2})+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "reason"],
                  "properties": {
                    "status": { "const": "error" },
                    "reason": { "const": "MALFORMED" }
                  }
                }
              ]
            },
            "tags": { "$ref": "#/$defs/tags" }
          }
        }
      ]
    }
  }
}
