// Type-check the web entry point the way its runtimes see it: no @types/node,
// so a stray `Buffer`, `process` or `node:*` import is a compile error here
// even though the main build (which has those types) would accept it. Emits
// nothing — tsconfig.json builds dist/, including dist/web/.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "src/web",
    "src/apple-date.ts",
    "src/bytes.ts",
    "src/call-clock.ts",
    "src/cms.ts",
    "src/der.ts",
    "src/environment.ts",
    "src/errors.ts",
    "src/json.ts",
    "src/limits.ts",
    "src/pem.ts",
    "src/receipt-payload.ts",
    "src/roots-data.ts",
    "src/safe-text.ts",
    "src/strict-utf8.ts",
    "src/x509.ts"
  ]
}
