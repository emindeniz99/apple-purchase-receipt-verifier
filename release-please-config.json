{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "apple-purchase-receipt-verifier",
      "extra-files": [
        {
          "type": "json",
          "path": "node/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "python/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "pom",
          "path": "java/pom.xml"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "build",
      "section": "Build & Dependencies"
    },
    {
      "type": "revert",
      "section": "Reverts"
    }
  ]
}
