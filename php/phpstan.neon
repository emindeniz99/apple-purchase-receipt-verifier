# Static analysis for the PHP port.
#
# Level max: the package is a façade whose types are simple (strings, ints,
# the module's decoded JSON narrowed on the way in).
#
# The gate that keeps verification logic out of src/ (no openssl_* call, no
# parser under src/Internal) is not configured here, because PHPStan has no
# built-in rule for it: it is tests/NoVerificationLogicTest.php, which runs on
# every matrix leg, not just the one static-analysis leg.
parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # Subprocess scripts (a fake aprv, a fake server) that read JSON they wrote themselves.
        - tests/Support/fake-aprv.php
        - tests/Support/fake-server.php
    treatPhpDocTypesAsCertain: true
