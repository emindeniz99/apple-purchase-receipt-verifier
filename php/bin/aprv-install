#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Downloads the `aprv` binary for this platform from the package's GitHub
 * Release, checks it against the SHA-256 pinned in SHA256SUMS and
 * installs it where the library looks for it (php/bin/aprv).
 *
 *   vendor/bin/aprv-install [--force] [--dir DIR] [--sums FILE]
 *                           [--target TARGET] [--base-url URL]
 *
 * Exit status: 0 installed (or already installed), 1 the download or the
 * hash failed and nothing was installed, 2 nothing to install (an
 * unsupported platform, or a checkout with no pinned release).
 */

use EminDeniz99\ApplePurchaseReceiptVerifier\Install\Installer;
use EminDeniz99\ApplePurchaseReceiptVerifier\Install\InstallException;

require_once dirname(__DIR__) . '/src/Install/InstallException.php';
require_once dirname(__DIR__) . '/src/Install/Installer.php';

// true: the option takes a value, as `--name VALUE` or `--name=VALUE`.
$known = ['force' => false, 'dir' => true, 'sums' => true, 'target' => true, 'base-url' => true, 'help' => false];
$options = getopt('', array_map(static fn (string $name): string => $name . ($known[$name] ? ':' : ''), array_keys($known)));
// getopt() drops, without a word, an option it does not know, a value option
// given no value, and it makes a repeated one an array. The arguments are
// walked once more so each of those is refused instead of running an
// install from the package's own SHA256SUMS.
$refused = null;
for ($i = 1; $i < $argc && $refused === null; $i++) {
    $argument = $argv[$i];
    $name = str_starts_with($argument, '--') ? explode('=', substr($argument, 2), 2)[0] : '';
    if (!array_key_exists($name, $known)) {
        $refused = 'unknown argument ' . $argument;
    } elseif ($known[$name]) {
        if (!str_contains($argument, '=')) {
            $i++;
        }
        if (!is_string($options[$name] ?? null) || $options[$name] === '') {
            $refused = "--{$name} needs one value";
        }
    }
}
if ($refused !== null || isset($options['help'])) {
    if ($refused !== null) {
        fwrite(STDERR, 'aprv-install: ' . $refused . "\n");
    }
    fwrite(STDERR, "usage: aprv-install [--force] [--dir DIR] [--sums FILE] [--target TARGET] [--base-url URL]\n");
    exit($refused !== null ? 2 : 0);
}

$string = static fn (string $name): ?string => $options[$name] ?? null;

try {
    $message = Installer::install(
        $string('sums') ?? dirname(__DIR__) . '/SHA256SUMS',
        $string('dir') ?? __DIR__,
        $string('base-url'),
        $string('target'),
        isset($options['force']),
    );
    fwrite(STDOUT, $message . "\n");
    exit(0);
} catch (InstallException $e) {
    fwrite(STDERR, 'aprv-install: ' . $e->getMessage() . "\n");
    exit($e->exitCode);
}
