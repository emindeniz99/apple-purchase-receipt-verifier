diff -ru a/src/clock.rs b/src/clock.rs
--- a/src/clock.rs	2026-09-26 08:45:43.583218085 +0000
+++ b/src/clock.rs	2026-09-26 08:45:43.605550081 +0000
@@ -29,7 +29,42 @@
 
 impl Clock for SystemClock {
     fn now(&self) -> SystemTime {
-        SystemTime::now()
+        system_now()
+    }
+}
+
+/// Spike (wasm bake-off): the one place the crate reads the host's wall
+/// clock. Native targets read `SystemTime::now()` as before. On
+/// `wasm32-unknown-unknown` (where `SystemTime::now()` traps) and on any
+/// wasm build compiled with `--cfg aprv_host_clock`, it reads the clock an
+/// adapter installed through [`platform::install_clock`] (SURFACE.md 4.1).
+/// Without an installed clock it panics, which is exactly today's trap.
+#[cfg(not(all(target_arch = "wasm32", any(target_os = "unknown", aprv_host_clock))))]
+pub(crate) fn system_now() -> SystemTime {
+    SystemTime::now()
+}
+
+#[cfg(all(target_arch = "wasm32", any(target_os = "unknown", aprv_host_clock)))]
+pub(crate) fn system_now() -> SystemTime {
+    match platform::CLOCK.get() {
+        Some(now) => now(),
+        None => panic!("no host clock installed"),
+    }
+}
+
+/// Spike: the wasm-only hook of SURFACE.md 4.1. It does not exist on
+/// native targets, so a native caller cannot move the validity instant.
+#[cfg(all(target_arch = "wasm32", any(target_os = "unknown", aprv_host_clock)))]
+pub mod platform {
+    use std::sync::OnceLock;
+    use std::time::SystemTime;
+
+    pub(crate) static CLOCK: OnceLock<fn() -> SystemTime> = OnceLock::new();
+
+    /// Installs the host's wall clock once. Only the wasm adapter calls it.
+    /// A second call is refused (`Err(())`), so the clock cannot be moved later.
+    pub fn install_clock(now: fn() -> SystemTime) -> Result<(), ()> {
+        CLOCK.set(now).map_err(|_| ())
     }
 }
 
