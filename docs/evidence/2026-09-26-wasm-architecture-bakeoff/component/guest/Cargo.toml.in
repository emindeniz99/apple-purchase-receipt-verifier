# Spike only. The Component Model form of the SAME C ABI and core: a
# wit-bindgen guest whose resources own the C ABI's handles. Built by
# component/build.sh through scripts/build-core.sh (SHIM=component/guest).
[package]
name = "aprv-component"
version = "0.0.0"
edition = "2021"
publish = false

[lib]
crate-type = ["cdylib"]
path = "src/lib.rs"

[dependencies]
wit-bindgen = { version = "=0.62.0", default-features = false, features = ["macros", "realloc"] }
apple-purchase-receipt-verifier-ffi = { path = "@TREE@/rust/ffi" }
aprv = { package = "apple-purchase-receipt-verifier", path = "@TREE@/rust" }

[features]
default = ["clock-seam"]
clock-seam = []
world-minimal = []

[lints.rust]
unexpected_cfgs = { level = "allow", check-cfg = ['cfg(aprv_host_clock)'] }

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
panic = "abort"
