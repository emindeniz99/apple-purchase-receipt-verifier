<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spike only (2026-09-26, ABI v1). The ABI v1 aprv.wasm compiled by Endive's
  build-time compiler (as in round 5), plus a bridge and the test runners.
  Pass the module with -Dabi.wasm=<path> (scripts/endive.sh).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>spike.aprv</groupId>
  <artifactId>aprv-abi1-endive</artifactId>
  <version>0.0.0-spike</version>
  <packaging>jar</packaging>
  <properties>
    <endive.version>1.1.0</endive.version>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <abi.wasm>MISSING-pass-Dabi.wasm</abi.wasm>
  </properties>
  <dependencies>
    <dependency>
      <groupId>run.endive</groupId>
      <artifactId>runtime</artifactId>
      <version>${endive.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>run.endive</groupId>
        <artifactId>endive-compiler-maven-plugin</artifactId>
        <version>${endive.version}</version>
        <executions>
          <execution>
            <id>abi</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <wasmFile>${abi.wasm}</wasmFile>
              <name>spike.aprv.abi.AbiModule</name>
              <interpreterFallback>FAIL</interpreterFallback>
              <methodPrefixer>run.endive.compiler.NameSectionMethodPrefixer</methodPrefixer>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
