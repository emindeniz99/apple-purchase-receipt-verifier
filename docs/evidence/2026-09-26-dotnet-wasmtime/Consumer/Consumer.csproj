<!--
  Spike only (2026-09-26). A clean consumer: takes the facade as a NuGet
  package from a local folder feed and Wasmtime from nuget.org (nuget.config
  written by scripts/build.sh), with an empty NUGET_PACKAGES.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aprv.Wasm.Spike" Version="0.0.0-spike" />
  </ItemGroup>
</Project>
