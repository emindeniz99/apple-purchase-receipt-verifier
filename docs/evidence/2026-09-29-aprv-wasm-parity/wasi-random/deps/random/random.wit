// wasi:random 0.2.6, the `random` interface as WASI 0.2 publishes it
// (https://github.com/WebAssembly/WASI/tree/main/wasip2/random), reduced to
// its two functions and without its documentation comments.
package wasi:random@0.2.6;

interface random {
  get-random-bytes: func(len: u64) -> list<u8>;
  get-random-u64: func() -> u64;
}
