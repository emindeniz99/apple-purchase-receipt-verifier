# Spike only (2026-09-29, round 12). aprv.wasm with the canonical ABI
# (Component Model) as its export ABI: the same core as ABI v1 (the
# round-4 no-asn1 template tree, OpenSSL 4.0.2, CMS path, core 0.6.0),
# bindings generated by wit-bindgen from wit/aprv.wit. scripts/build.sh
# copies this file to the scratch tree and replaces @TREE@ with the ABI v1
# round's patched scratch copy of rust/ (the tree that built b14e14b2...).
[package]
name = "aprv-wasm-cabi"
version = "0.0.0"
edition = "2021"
publish = false

[lib]
crate-type = ["cdylib"]
path = "src/lib.rs"

[dependencies]
aprv = { package = "apple-purchase-receipt-verifier", path = "@TREE@/rust", features = ["endpoint"] }
# Only the generator macro and cabi_realloc: no async runtime, no bitflags.
wit-bindgen = { version = "=0.62.0", default-features = false, features = ["macros", "realloc"] }

[lints.rust]
unexpected_cfgs = { level = "allow", check-cfg = ['cfg(aprv_host_clock)'] }

# As ABI v1.
[profile.release]
opt-level = 3
lto = true
codegen-units = 1
panic = "abort"
