<!--
  A clean consumer of the packed library: the package comes from a local folder
  feed and Wasmtime from nuget.org (nuget.config written by
  scripts/consumer.sh), into an empty NUGET_PACKAGES.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ApplePurchaseReceiptVerifier" Version="0.7.0" />
  </ItemGroup>
</Project>
