<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Wasm host for aprv.wasm. 48.0.2 is the floor the evidence ran and
         the newest release on nuget.org; netstandard2.0 is one of its targets. -->
    <PackageVersion Include="Wasmtime" Version="48.0.2" />
    <!-- Build-time only: makes new X509Chain() and DateTime.UtcNow compile errors. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="test-only">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.3.3" />
  </ItemGroup>
</Project>
