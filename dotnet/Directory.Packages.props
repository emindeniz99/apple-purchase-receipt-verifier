<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- CMS/PKCS#7 SignedData decoding + SignerInfo.CheckSignature. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.11" />
    <!-- AsnReader/AsnDecoder: in-box from net8.0, a package on netstandard2.0. -->
    <PackageVersion Include="System.Formats.Asn1" Version="10.0.11" />
    <!-- Build-time only: makes new X509Chain() and DateTime.UtcNow compile errors. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="test-only">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="1.9.1" />
  </ItemGroup>
</Project>
