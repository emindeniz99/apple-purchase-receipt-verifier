<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-port benchmark (BENCHMARKS.md at the repository root): a plain
       console app timed with System.Diagnostics.Stopwatch, no package of its
       own. Deliberately NOT a member of ApplePurchaseReceiptVerifier.sln, like
       fuzz/: `dotnet build`, `dotnet test` and `dotnet format` resolve that
       solution, so keeping this project out of it keeps it away from the
       shipped package, its trim and AOT checks and the formatting gate. The
       library is referenced, never modified. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ApplePurchaseReceiptVerifier.Bench</RootNamespace>
    <AssemblyName>ApplePurchaseReceiptVerifier.Bench</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/ApplePurchaseReceiptVerifier/ApplePurchaseReceiptVerifier.csproj"
                      SetTargetFramework="TargetFramework=net8.0" />
  </ItemGroup>

</Project>
