<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-port benchmark (BENCHMARKS.md at the repository root).
       Deliberately NOT a member of ApplePurchaseReceiptVerifier.sln, like
       fuzz/: `dotnet build`, `dotnet test` and `dotnet format` resolve that
       solution, so keeping this project out of it is what stops
       BenchmarkDotNet from reaching the shipped package, its trim and AOT
       checks or the formatting gate. The library is referenced, never
       modified. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ApplePurchaseReceiptVerifier.Bench</RootNamespace>
    <AssemblyName>ApplePurchaseReceiptVerifier.Bench</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet is the only package here and it is pinned inline, so
         the repository's central version list stays a description of what
         ships. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/ApplePurchaseReceiptVerifier/ApplePurchaseReceiptVerifier.csproj"
                      SetTargetFramework="TargetFramework=net8.0" />
  </ItemGroup>

</Project>
