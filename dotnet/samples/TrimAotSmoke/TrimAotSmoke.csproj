<Project Sdk="Microsoft.NET.Sdk">

  <!-- Publishes the library into a fully trimmed, invariant-globalization
       binary and verifies a receipt with it. Trimming is the closest
       CI-runnable proxy for Unity IL2CPP's stripping: a reflection-based
       serializer or an embedded resource would show up here as an IL2xxx
       warning or a runtime failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>TrimAotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SelfContained>true</SelfContained>
    <!-- Pinned rather than inferred from the host. A self-contained
         publish takes the host RID by default, which would put a
         different graph in packages.lock.json on each of the three OS
         legs and fail locked-mode restore on two of them. The only job
         that publishes this sample passes -r linux-x64 anyway. -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ApplePurchaseReceiptVerifier/ApplePurchaseReceiptVerifier.csproj" />
  </ItemGroup>

</Project>
