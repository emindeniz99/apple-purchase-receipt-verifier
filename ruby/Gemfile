# frozen_string_literal: true

source "https://rubygems.org"

# The gemspec is deliberately NOT loaded here. `gemspec` would put the library
# itself in Gemfile.lock as a path gem carrying its own version, and a
# release-please commit that bumps only version.rb would then make every
# frozen install fail on a lockfile it cannot update. Nothing needs it: the
# Rakefile puts lib/ and test/ on the load path itself. The one runtime
# dependency is named here as the gemspec names it, so the tests run against
# the same wasmtime the gem asks for.
#
# minitest ships with Ruby as a bundled gem; naming it keeps `bundle exec`
# honest on rubies where the bundled set changes.
gem "minitest", "~> 6.0"
gem "rake", "~> 13.0"
gem "wasmtime", ">= 48.0.1"
