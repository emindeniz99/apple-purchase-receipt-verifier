module ApplePurchaseReceiptVerifier
  VERSION: String

  module Version
    def self.current: () -> String
  end

  type root = String | _ToDer
  type roots = Array[root]
  type clock = ^() -> Integer

  interface _ToDer
    def to_der: () -> String
  end

  module Reason
    MALFORMED: Symbol
    TOO_LARGE: Symbol
    INVALID_SIGNATURE: Symbol
    UNTRUSTED_CHAIN: Symbol
    INVALID_CERTIFICATE: Symbol
    INVALID_CERTIFICATE_PURPOSE: Symbol
    UNREADABLE_PAYLOAD: Symbol
    INTERNAL_ERROR: Symbol
    ALL: Array[Symbol]
  end

  module Environment
    PRODUCTION: String
    SANDBOX: String
    ALL: Array[String]
  end

  module AppleStatus
    OK: Integer
    REQUEST_NOT_POST: Integer
    NO_LONGER_SENT: Integer
    MALFORMED_RECEIPT_DATA: Integer
    RECEIPT_NOT_AUTHENTICATED: Integer
    SHARED_SECRET_MISMATCH: Integer
    SERVER_UNAVAILABLE: Integer
    SUBSCRIPTION_EXPIRED: Integer
    SANDBOX_RECEIPT_ON_PRODUCTION: Integer
    PRODUCTION_RECEIPT_ON_SANDBOX: Integer
    INTERNAL_DATA_ACCESS_ERROR: Integer
    ACCOUNT_NOT_FOUND: Integer
    INTERNAL_DATA_ACCESS_ERROR_RANGE_FIRST: Integer
    INTERNAL_DATA_ACCESS_ERROR_RANGE_LAST: Integer

    def self.for_reason: (Symbol reason) -> Integer
  end

  class AbiMismatchError < StandardError
  end

  class ModuleIntegrityError < StandardError
  end

  class TrapError < StandardError
  end

  class Config
    SYSTEM_CLOCK: clock

    attr_reader roots: Array[String]
    attr_reader clock: clock

    def initialize: (?roots: roots?, ?clock: clock?) -> void
    def custom_roots?: () -> bool
  end

  class Failure
    attr_reader reason: Symbol
    attr_reader message: String
    attr_reader cause: Exception?
    def initialize: (reason: Symbol, message: String, cause: Exception?) -> void
  end

  class VerificationResult
    attr_reader verified: bool
    attr_reader payload: (ReceiptPayload | JsonPayload)?
    attr_reader failure: Failure?
    def initialize: (verified: bool, payload: (ReceiptPayload | JsonPayload)?, failure: Failure?) -> void
    def verified?: () -> bool
    def self.ok: ((ReceiptPayload | JsonPayload) payload) -> VerificationResult
    def self.error: (Failure failure) -> VerificationResult
  end

  class Verifier
    def self.create: (Config config) -> Verifier
    def verify_receipt: (String base64) -> VerificationResult
    def verify_signed_data: (String jws) -> VerificationResult
    def verify_receipt_endpoint: (String environment, String request_json) -> String
  end

  class JsonPayload
    attr_reader json: String
    attr_reader environment: String?
    def initialize: (json: String, environment: String?) -> void
  end

  class InAppPurchase
    attr_reader quantity: Integer?
    attr_reader product_id: String?
    attr_reader transaction_id: String?
    attr_reader purchase_date_ms: Integer?
    attr_reader original_transaction_id: String?
    attr_reader original_purchase_date_ms: Integer?
    attr_reader expires_date_ms: Integer?
    attr_reader web_order_line_item_id: Integer?
    attr_reader cancellation_date_ms: Integer?
    attr_reader is_trial_period: bool?
    attr_reader is_in_intro_offer_period: bool?
    attr_reader unknown_attributes: Hash[Integer, Array[String]]

    def initialize: (quantity: Integer?, product_id: String?, transaction_id: String?,
                     purchase_date_ms: Integer?, original_transaction_id: String?,
                     original_purchase_date_ms: Integer?, expires_date_ms: Integer?,
                     web_order_line_item_id: Integer?, cancellation_date_ms: Integer?,
                     is_trial_period: bool?, is_in_intro_offer_period: bool?,
                     unknown_attributes: Hash[Integer, Array[String]]) -> void
    def json_value: () -> Hash[String, untyped]
  end

  class ReceiptPayload
    attr_reader receipt_type: String?
    attr_reader app_item_id: Integer?
    attr_reader bundle_id: String?
    attr_reader bundle_id_bytes: String?
    attr_reader application_version: String?
    attr_reader opaque_value: String?
    attr_reader sha1_hash: String?
    attr_reader receipt_creation_date_ms: Integer?
    attr_reader download_id: Integer?
    attr_reader version_external_identifier: Integer?
    attr_reader in_app: Array[InAppPurchase]
    attr_reader original_purchase_date_ms: Integer?
    attr_reader original_application_version: String?
    attr_reader expiration_date_ms: Integer?
    attr_reader unknown_attributes: Hash[Integer, Array[String]]
    attr_reader environment: String?

    def initialize: (receipt_type: String?, app_item_id: Integer?, bundle_id: String?,
                     bundle_id_bytes: String?, application_version: String?, opaque_value: String?,
                     sha1_hash: String?, receipt_creation_date_ms: Integer?, download_id: Integer?,
                     version_external_identifier: Integer?, in_app: Array[InAppPurchase],
                     original_purchase_date_ms: Integer?, original_application_version: String?,
                     expiration_date_ms: Integer?, unknown_attributes: Hash[Integer, Array[String]],
                     environment: String?) -> void
    def to_json: (*untyped) -> String
  end
end
