module ApplePurchaseReceiptVerifier
  VERSION: String

  module Version
    def self.current: () -> String
  end

  # Base64 DER of the three bundled Apple root certificates.
  APPLE_ROOT_DER_BASE64: Array[String]

  LEAF_MARKER_OID: String
  INTERMEDIATE_MARKER_OID: String
  RECEIPT_SIGNER_OID: String
  WWDR_INTERMEDIATE_OID: String

  type root = OpenSSL::X509::Certificate | String
  type roots = Array[root]
  type clock = ^() -> Integer

  module Reason
    MALFORMED: Symbol
    TOO_LARGE: Symbol
    INVALID_SIGNATURE: Symbol
    UNTRUSTED_CHAIN: Symbol
    INVALID_CERTIFICATE: Symbol
    INVALID_CERTIFICATE_PURPOSE: Symbol
    UNREADABLE_PAYLOAD: Symbol
    INTERNAL_ERROR: Symbol
    ALL: Array[Symbol]
  end

  module Environment
    PRODUCTION: String
    SANDBOX: String
    ALL: Array[String]

    def self.from_receipt_type: (String? receipt_type) -> String?
    def self.from_jws_environment: (String? claim) -> String?
  end

  module AppleStatus
    OK: Integer
    REQUEST_NOT_POST: Integer
    NO_LONGER_SENT: Integer
    MALFORMED_RECEIPT_DATA: Integer
    RECEIPT_NOT_AUTHENTICATED: Integer
    SHARED_SECRET_MISMATCH: Integer
    SERVER_UNAVAILABLE: Integer
    SUBSCRIPTION_EXPIRED: Integer
    SANDBOX_RECEIPT_ON_PRODUCTION: Integer
    PRODUCTION_RECEIPT_ON_SANDBOX: Integer
    INTERNAL_DATA_ACCESS_ERROR: Integer
    ACCOUNT_NOT_FOUND: Integer
    INTERNAL_DATA_ACCESS_ERROR_RANGE_FIRST: Integer
    INTERNAL_DATA_ACCESS_ERROR_RANGE_LAST: Integer

    def self.for_reason: (Symbol reason) -> Integer
  end

  class VerificationError < StandardError
    attr_reader reason: Symbol
    attr_reader cause_error: Exception?
    def initialize: (Symbol reason, String detail, ?cause_error: Exception?) -> void
  end

  module SafeText
    MAX_LENGTH: Integer
    def self.quote: (untyped value) -> String
  end

  class Config
    SYSTEM_CLOCK: clock

    attr_reader roots: Array[OpenSSL::X509::Certificate]
    attr_reader clock: clock

    def self.defaults: () -> Config
    def self.builder: () -> Config::Builder

    def initialize: (?roots: roots?, ?clock: clock?) -> void

    class Builder
      def initialize: () -> void
      def roots: (roots) -> self
      def clock: (clock) -> self
      def build: () -> Config
    end
  end

  class Failure
    attr_reader reason: Symbol
    attr_reader message: String
    attr_reader cause: Exception?
    def initialize: (reason: Symbol, message: String, cause: Exception?) -> void
  end

  class VerificationResult
    attr_reader verified: bool
    attr_reader payload: (ReceiptPayload | JsonPayload)?
    attr_reader failure: Failure?
    def initialize: (verified: bool, payload: (ReceiptPayload | JsonPayload)?, failure: Failure?) -> void
    def verified?: () -> bool
    def self.ok: ((ReceiptPayload | JsonPayload) payload) -> VerificationResult
    def self.error: (Failure failure) -> VerificationResult
  end

  class Verifier
    def self.create: (Config config) -> Verifier
    def verify_receipt: (String base64) -> VerificationResult
    def verify_signed_data: (String jws) -> VerificationResult
    def verify_receipt_endpoint: (String environment, String request_json) -> String
  end

  class JsonPayload
    attr_reader json: String
    def initialize: (json: String) -> void
  end

  class InAppPurchase
    attr_reader quantity: Integer?
    attr_reader product_id: String?
    attr_reader transaction_id: String?
    attr_reader purchase_date_ms: Integer?
    attr_reader original_transaction_id: String?
    attr_reader original_purchase_date_ms: Integer?
    attr_reader expires_date_ms: Integer?
    attr_reader web_order_line_item_id: Integer?
    attr_reader cancellation_date_ms: Integer?
    attr_reader is_trial_period: bool?
    attr_reader is_in_intro_offer_period: bool?
    attr_reader unknown_attributes: Hash[Integer, Array[String]]

    def initialize: (quantity: Integer?, product_id: String?, transaction_id: String?,
                     purchase_date_ms: Integer?, original_transaction_id: String?,
                     original_purchase_date_ms: Integer?, expires_date_ms: Integer?,
                     web_order_line_item_id: Integer?, cancellation_date_ms: Integer?,
                     is_trial_period: bool?, is_in_intro_offer_period: bool?,
                     unknown_attributes: Hash[Integer, Array[String]]) -> void
    def write_json: (untyped json) -> void
  end

  class ReceiptPayload
    attr_reader receipt_type: String?
    attr_reader app_item_id: Integer?
    attr_reader bundle_id: String?
    attr_reader bundle_id_bytes: String?
    attr_reader application_version: String?
    attr_reader opaque_value: String?
    attr_reader sha1_hash: String?
    attr_reader receipt_creation_date_ms: Integer?
    attr_reader download_id: Integer?
    attr_reader version_external_identifier: Integer?
    attr_reader in_app: Array[InAppPurchase]
    attr_reader original_purchase_date_ms: Integer?
    attr_reader original_application_version: String?
    attr_reader expiration_date_ms: Integer?
    attr_reader unknown_attributes: Hash[Integer, Array[String]]

    def initialize: (receipt_type: String?, app_item_id: Integer?, bundle_id: String?,
                     bundle_id_bytes: String?, application_version: String?, opaque_value: String?,
                     sha1_hash: String?, receipt_creation_date_ms: Integer?, download_id: Integer?,
                     version_external_identifier: Integer?, in_app: Array[InAppPurchase],
                     original_purchase_date_ms: Integer?, original_application_version: String?,
                     expiration_date_ms: Integer?, unknown_attributes: Hash[Integer, Array[String]]) -> void
    def to_json: (*untyped) -> String
  end

  module Roots
    APPLE_ROOT_SHA256: Array[String]
    def self.apple_roots: () -> Array[OpenSSL::X509::Certificate]
  end

  module CertificateStructure
    def self.sound?: (OpenSSL::X509::Certificate certificate) -> bool
  end

  module Asn1
    MAX_DEPTH: Integer
    MAX_NODES: Integer

    TAG_INTEGER: Integer
    TAG_OCTET_STRING: Integer
    TAG_OID: Integer
    TAG_UTF8_STRING: Integer
    TAG_IA5_STRING: Integer
    TAG_SEQUENCE: Integer
    TAG_SET: Integer
    TAG_CONTEXT_0: Integer
    TAG_OCTET_STRING_BER: Integer

    class Error < StandardError
    end

    def self.scan!: (String bytes) -> Integer
    def self.parse: (String bytes, ?depth_limit: Integer) -> Node
    def self.parse_scanned: (String bytes, ?depth_limit: Integer) -> Node
    def self.read_single: (String bytes) -> [Integer, String]
    def self.oid_string: (String contents) -> String

    class Node
      attr_accessor buffer: String
      attr_accessor tag: Integer
      attr_accessor constructed: bool
      attr_accessor start: Integer
      attr_accessor finish: Integer
      attr_accessor content_start: Integer
      attr_accessor content_end: Integer
      attr_accessor children: Array[Node]?
      def raw: () -> String
      def content: () -> String
      def content_length: () -> Integer
      def kids: () -> Array[Node]
      def octet_string?: () -> bool
      def octet_value: () -> String
    end
  end

  class ClockOnce
    def initialize: (clock clock) -> void
    def millis: () -> Integer
  end

  module Chain
    MAX_PATH_LENGTH: Integer
    KEY_CERT_SIGN_BIT: Integer
    PROCESSED_EXTENSIONS: Array[String]
    PROCESSED_LEAF_EXTENSIONS: Array[String]

    def self.normalize_roots: (roots) -> Array[OpenSSL::X509::Certificate]
    def self.valid_at?: (OpenSSL::X509::Certificate, Integer at_millis) -> bool
    def self.issued_by?: (OpenSSL::X509::Certificate, OpenSSL::X509::Certificate) -> bool
    def self.ca?: (OpenSSL::X509::Certificate) -> bool
    def self.authenticated_top_down: (Array[OpenSSL::X509::Certificate] embedded,
                                      Array[OpenSSL::X509::Certificate] anchors) -> Array[OpenSSL::X509::Certificate]
    def self.build_and_validate_path: (OpenSSL::X509::Certificate target,
                                       Array[OpenSSL::X509::Certificate] authenticated,
                                       Array[OpenSSL::X509::Certificate] anchors,
                                       Integer instant) -> Array[OpenSSL::X509::Certificate]
    def self.validate_pair: (OpenSSL::X509::Certificate leaf, OpenSSL::X509::Certificate intermediate,
                             Array[OpenSSL::X509::Certificate] anchors, Integer instant) -> void
    def self.keys_used_during: [T] () { () -> T } -> Array[untyped]
    def self.decode_public_key!: (OpenSSL::X509::Certificate cert) -> OpenSSL::PKey::PKey
  end

  module PacificTime
    STANDARD_OFFSET: Integer
    DAYLIGHT_OFFSET: Integer
    ZONE_LABEL: String
    def self.wall_clock: (Time) -> Time
    def self.offset: (Time) -> Integer
  end
end
