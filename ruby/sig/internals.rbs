# Signatures for everything `sig/apple_purchase_receipt_verifier.rbs` leaves
# out: private methods, module-internal constants, and the modules that are
# implementation detail (Runtime, Guest, InstancePool, Wire, PayloadJson),
# plus the slice of the `wasmtime` gem they call, which ships no signatures.
#
# A consumer type-checks against the public file; this one exists so
# `steep check` can prove the implementation itself, and it is checked by CI
# for exactly that reason. Nothing here is API: a name in this file may change
# in any release.
module Wasmtime
  VERSION: String

  class Error < StandardError
  end

  class Trap < Error
    def code: () -> Symbol?
  end

  class Engine
    def self.new: () -> Engine
  end

  class Module
    def self.new: (Engine engine, String bytes) -> Module
    def imports: () -> Array[Hash[String, untyped]]
  end

  class Linker
    def self.new: (Engine engine) -> Linker
    def func_new: (String module_name, String name, Array[Symbol] params, Array[Symbol] results) { (Caller, *Integer) -> untyped } -> void
    def instantiate: (Store store, Module wasm_module) -> Instance
  end

  class Store
    def self.new: (Engine engine, ?limits: Hash[Symbol, Integer]) -> Store
    def close: () -> void
    def closed?: () -> bool
    def linear_memory_limit_hit?: () -> bool
    def max_linear_memory_consumed: () -> Integer
  end

  class Instance
    def exports: () -> Hash[String, Extern]
  end

  class Extern
    def to_memory: () -> Memory
    def to_func: (?gvl: bool) -> Func
  end

  class Caller
    def export: (String name) -> Extern
  end

  class Memory
    def data_size: () -> Integer
    def read: (Integer offset, Integer size) -> String
    def read_u32: (Integer offset) -> Integer
    def write: (Integer offset, String data) -> untyped
    def write_u32: (Integer offset, Integer value) -> untyped
  end

  class Func
    def call: (*untyped args) -> untyped
  end
end

module ApplePurchaseReceiptVerifier
  class Verifier
    ENV_CODES: Hash[String, Integer]
    MAX_CLOCK_MILLIS: Integer

    class ClockError < StandardError
    end

    def initialize: (Config config, ?runtime: Runtime) -> void

    private

    def verify: (String operation, untyped input) { (String) -> VerificationResult } -> VerificationResult
    def call: [T] (String operation, Array[Integer] scalars, String input) { (String) -> T } -> T
    def read_clock: () -> Integer
    def endpoint_answer: (Integer env, untyped request_json) -> String
    def internal_error: (Exception cause) -> VerificationResult
    def status_only: (Symbol reason) -> String
  end

  class Config
    private

    def none: () -> Array[String]
    def normalize: (untyped roots) -> Array[String]
    def bytes_of: (untyped root) -> String
  end

  class RootsRejected < StandardError
  end

  class Runtime
    ABI: String
    HOST: String
    RANDOM_GET: String
    OPERATIONS: Array[String]
    MAX_RANDOM_BYTES: Integer
    MODULE_PATH: String
    LOCK: Thread::Mutex
    HASH_PATH: String

    self.@shared: Runtime?

    attr_reader engine: Wasmtime::Engine
    attr_reader wasm_module: Wasmtime::Module
    attr_reader linker: Wasmtime::Linker

    def self.shared: () -> Runtime
    def self.read_module: (?String path, ?String hash_path) -> String
    def initialize: (String bytes, ?random: ^(Integer) -> String) -> void

    private

    def compile: (String bytes) -> Wasmtime::Module
    def refuse_other_imports: () -> void
    def random_get: (Wasmtime::Caller caller, Integer length, Integer retptr) -> void
  end

  class Guest
    LIMITS: Hash[Symbol, Integer]
    MAX_INPUT_BYTES: Integer

    @broken: bool
    @store: Wasmtime::Store
    @memory: Wasmtime::Memory
    @realloc: Wasmtime::Func
    @operations: Hash[String, [Wasmtime::Func, Wasmtime::Func]]

    def initialize: (Runtime runtime, String? config_json) -> void
    def broken?: () -> bool
    def close: () -> void
    def call: (String name, Array[Integer] scalars, String input) -> String

    private

    def instantiate: (Runtime runtime) -> Hash[String, Wasmtime::Extern]
    def start: (String config_json) -> void
    def discard: () -> void
    def lower: (String bytes) -> Integer
    def lift: (Integer retptr) -> String
    def check_memory_limit: () -> void
    def describe: (Wasmtime::Error error) -> String
  end

  class InstancePool
    MAX_IDLE: Integer

    @runtime: Runtime
    @config_json: String
    @idle: Thread::Queue

    def initialize: (Runtime runtime, String config_json) -> void
    def with_guest: [T] () { (Guest) -> T } -> T
    def idle_count: () -> Integer

    private

    def checkout: () -> Guest
  end

  module Wire
    DECIMAL: Regexp
    UNKNOWN_KEY: Regexp
    REASON_TOKEN: Regexp

    def self.init_status: (String text) -> String?
    def self.receipt_result: (String text) -> VerificationResult
    def self.signed_data_result: (String text) -> VerificationResult

    def self.result: (String text, String operation) { (untyped) -> (ReceiptPayload | JsonPayload) } -> VerificationResult
    def self.failure: (Hash[String, untyped] answer, String operation) -> Failure
    def self.object: (String text, String operation) -> Hash[String, untyped]
    def self.receipt_payload: (untyped payload) -> ReceiptPayload
    def self.in_app_purchase: (untyped purchase) -> InAppPurchase
    def self.unknown_attributes: (Hash[String, untyped] container) -> Hash[Integer, Array[String]]
    def self.list: [T] (Hash[String, untyped] container, String key) { (untyped) -> T } -> Array[T]
    def self.string: (Hash[String, untyped] container, String key) -> String?
    def self.required_string: (Hash[String, untyped] container, String key) -> String
    def self.integer: (Hash[String, untyped] container, String key) -> Integer?
    def self.boolean: (Hash[String, untyped] container, String key) -> bool?
    def self.id: (Hash[String, untyped] container, String key) -> Integer?
    def self.bytes: (Hash[String, untyped] container, String key) -> String?
    def self.decode_base64: (untyped value, String where) -> String
  end

  module PayloadJson
    def self.unknown_attributes: (Hash[Integer, Array[String]] attributes) -> Hash[String, Array[String]]
  end
end
