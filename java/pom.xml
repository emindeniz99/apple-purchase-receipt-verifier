<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.emindeniz99</groupId>
  <artifactId>apple-purchase-receipt-verifier</artifactId>
  <version>0.4.0</version>
  <packaging>jar</packaging>

  <name>apple-purchase-receipt-verifier</name>
  <description>Verify Apple in-app purchases locally (StoreKit 2 JWS + legacy PKCS#7 receipts) with zero Apple server calls</description>
  <url>https://github.com/emindeniz99/apple-purchase-receipt-verifier</url>

  <!-- license/developers/scm are Maven Central publishing requirements,
       validated at upload — not optional metadata. -->
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>emindeniz99</id>
      <name>Emin Deniz</name>
      <email>emindeniz99@gmail.com</email>
      <url>https://github.com/emindeniz99</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/emindeniz99/apple-purchase-receipt-verifier.git</connection>
    <developerConnection>scm:git:git@github.com:emindeniz99/apple-purchase-receipt-verifier.git</developerConnection>
    <url>https://github.com/emindeniz99/apple-purchase-receipt-verifier</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!-- Java 8 baseline (PLAN.md D2): enterprise consumers still run 8. -->
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <bouncycastle.version>1.85</bouncycastle.version>
    <!-- Floor: Jackson 2.16. JwsVerifier and VerifyReceiptEndpoint state
         StreamReadConstraints on their mappers rather than relying on
         Jackson's defaults, because the JWS header is parsed before any
         signature check and a host BOM pinning an older Jackson 2 would
         otherwise link cleanly and silently lose the nesting guard.
         StreamReadConstraints arrived in 2.15 and maxDocumentLength in
         2.16, so below 2.16 the verifier fails at construction instead. -->
    <jackson.version>2.22.2</jackson.version>
    <!-- Annotations only, and only at compile time: see the <optional>
         dependency below. -->
    <jspecify.version>1.0.1</jspecify.version>
    <junit.version>5.14.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- JSpecify nullness annotations on the public API, so Kotlin sees
         String? / String instead of platform types and NullAway/Checker
         users get real diagnostics. <optional>true</optional>, so consumers
         do not inherit it: the annotations are retained in the class files
         but nothing reads them at run time, and a JVM reflecting over a
         member annotated with a type it cannot load ignores that annotation
         rather than failing (JLS 13.5.7 / AnnotatedElement). A consumer who
         runs NullAway or the Checker Framework declares the same artifact
         themselves. Java 8 safe: the annotation class files are major
         version 52 (the jar's module-info is 53, and a classpath build
         never reads it). -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Ship the MIT text inside the jar. -->
      <resource>
        <directory>.</directory>
        <includes>
          <include>LICENSE</include>
        </includes>
        <targetPath>META-INF</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <!-- Emit MethodParameters so JVM-language consumers see real
               parameter names. Without it Kotlin named arguments against
               this jar fail to resolve (the compiler sees p0, p1, ...),
               which the jvm-interop module caught. Costs a few bytes per
               method and is not a source or binary break. -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- Automatic-Module-Name so a consumer on the module path gets
                   a stable module name instead of one derived from the jar
                   file name, which changes with every version. The jar stays
                   a plain classpath jar with no module-info: the Java 8
                   baseline (PLAN.md D2) cannot compile one. -->
              <Automatic-Module-Name>io.github.emindeniz99.applepurchasereceiptverifier</Automatic-Module-Name>
              <!-- Implementation-* so a deployed jar can say which build it
                   is: Package.getImplementationVersion() answers from these,
                   which is how a support request identifies the artifact it
                   is actually running. -->
              <Implementation-Title>${project.artifactId}</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <!-- Format/lint gate: not bound to any lifecycle phase, so `mvn test`
           (including the java-runtime-8 profile) never touches it. Invoked
           explicitly via `mvn spotless:apply` / `mvn spotless:check`, which
           the java-format CI job runs on a modern JDK. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
        <configuration>
          <java>
            <!-- The default is the two source roots; naming them explicitly
                 is what lets fuzz/src join, and the fuzz harness is held to
                 the same format as the library even though Maven never
                 compiles it (fuzz/run.sh does, with a modern javac). -->
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
              <include>fuzz/src/**/*.java</include>
            </includes>
            <palantirJavaFormat>
              <version>2.97.0</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Runs the suite on a real Java 8 JVM (the artifact's floor) while
         Maven and javac stay modern. CI passes the JVM path:
         mvn test -Pjdk8-runtime -Djdk8.jvm=/path/to/jdk8/bin/java -->
    <profile>
      <id>jdk8-runtime</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <jvm>${jdk8.jvm}</jvm>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Everything Maven Central demands beyond a plain build: sources jar,
         javadoc jar, GPG signatures, and the Central Portal uploader.
         Activated only at release (mvn -P central deploy) so day-to-day
         `mvn test` stays fast and needs no GPG key. Credentials: the
         portal token lives in ~/.m2/settings.xml under server id
         `central`; the GPG passphrase comes from gpg-agent. -->
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
